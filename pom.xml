<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.aerospike</groupId>
  <artifactId>aerospike-client-metrics-exporter-parent</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Aerospike Java Client Metrics Exporter</name>
  <description>Optional OpenTelemetry and Prometheus exporters for Aerospike Java client metrics.</description>

  <modules>
    <module>build-support/client-contract-jdk8-stub</module>
    <module>common</module>
    <module>otel</module>
    <module>prometheus</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>

    <aerospike.client.version>10.5.0</aerospike.client.version>
    <opentelemetry.version>1.62.0</opentelemetry.version>
    <opentelemetry.prometheus.alpha.version>1.62.0-alpha</opentelemetry.prometheus.alpha.version>
    <prometheus.version>1.10.0</prometheus.version>
    <junit.version>5.12.2</junit.version>
    <testcontainers.version>1.21.4</testcontainers.version>

    <maven.compiler.version>3.14.0</maven.compiler.version>
    <maven.enforcer.version>3.5.0</maven.enforcer.version>
    <maven.failsafe.version>3.5.3</maven.failsafe.version>
    <maven.surefire.version>3.5.3</maven.surefire.version>
    <skipITs>true</skipITs>
    <!-- TODO(OM-386): Remove only after deleting the temporary contract stub. -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.aerospike</groupId>
        <artifactId>aerospike-client-jdk8</artifactId>
        <version>${aerospike.client.version}</version>
      </dependency>
      <dependency>
        <groupId>com.aerospike</groupId>
        <artifactId>aerospike-client-metrics-jdk8-contract-stub</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>com.aerospike</groupId>
        <artifactId>aerospike-client-metrics-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.aerospike</groupId>
        <artifactId>aerospike-client-metrics-otel</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>io.opentelemetry</groupId>
        <artifactId>opentelemetry-bom</artifactId>
        <version>${opentelemetry.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${testcontainers.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.version}</version>
          <configuration>
            <source>${maven.compiler.source}</source>
            <target>${maven.compiler.target}</target>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.version}</version>
          <configuration>
            <useModulePath>false</useModulePath>
            <includes>
              <include>**/Test*.java</include>
            </includes>
            <excludedGroups>integration</excludedGroups>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven.failsafe.version}</version>
          <configuration>
            <skipITs>${skipITs}</skipITs>
            <useModulePath>false</useModulePath>
            <includes>
              <include>**/Test*Integration.java</include>
            </includes>
            <groups>integration</groups>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven.enforcer.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      TODO(OM-386): Re-enable this module by default after client-jdk8 owns
      MetricsSnapshot, IMetricsExporter and the custom MetricsPolicy hooks.
    -->
    <profile>
      <id>future-jdk8-client-contract</id>
      <modules>
        <module>examples</module>
      </modules>
    </profile>
    <profile>
      <id>integration-tests</id>
      <properties>
        <skipITs>false</skipITs>
      </properties>
    </profile>
  </profiles>
</project>
